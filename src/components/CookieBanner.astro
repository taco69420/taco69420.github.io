---
// Analytics notice + opt-out (US-audience model)
// - Analytics loads by default on every page load, UNLESS the visitor has
//   previously opted out (stored as 'declined' in localStorage).
// - Accept / OK: records consent, hides the notice, analytics continues.
// - Decline: records an opt-out, disables analytics for this and future visits.
// - window.CookieConsent.showPreferences() re-opens the notice (used by the
//   privacy page button) so a visitor can change their choice at any time.
---

<div
  id="gdpr-banner"
  role="dialog"
  aria-live="polite"
  aria-label="Analytics notice"
  style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;background:#18181b;border-top:2px solid #3f3f46;padding:1rem 1.5rem;color:#e4e4e7;box-shadow:0 -4px 24px rgba(0,0,0,0.4);"
>
  <div style="max-width:800px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;gap:1rem;justify-content:space-between;">
    <p style="margin:0;font-size:0.875rem;line-height:1.6;flex:1;min-width:240px;">
      This site uses Google Analytics to understand how visitors use it — no ads,
      no selling of your data. You can opt out any time.
      <a href="/privacy/" style="color:#10b981;font-weight:600;">Privacy Policy</a>
      &middot;
      <a href="/privacy/#do-not-sell" style="color:#10b981;font-weight:600;">Do Not Sell My Info</a>
    </p>
    <div style="display:flex;gap:0.75rem;flex-shrink:0;">
      <button
        id="gdpr-decline"
        type="button"
        style="min-height:44px;padding:0.6rem 1.25rem;border-radius:6px;border:2px solid #52525b;background:transparent;color:#a1a1aa;font-size:0.875rem;font-weight:600;cursor:pointer;"
      >
        Opt out
      </button>
      <button
        id="gdpr-accept"
        type="button"
        style="min-height:44px;padding:0.6rem 1.25rem;border-radius:6px;border:none;background:#10b981;color:#fff;font-size:0.875rem;font-weight:600;cursor:pointer;"
      >
        OK
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'gdpr-consent';
    var GA_ID = 'G-WGL40V0V8V';

    function loadAnalytics() {
      if (window.__gdprAnalyticsLoaded) return;
      window.__gdprAnalyticsLoaded = true;

      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);

      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GA_ID);

      // Track Amazon affiliate link clicks
      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[href*="amzn.to"], a[href*="amazon.com"]');
        if (!link) return;
        var href = link.getAttribute('href') || '';
        var text = (link.textContent || '').trim().slice(0, 100);
        gtag('event', 'affiliate_click', {
          link_url: href,
          link_text: text,
          page_location: window.location.href
        });
      });
    }

    function readConsent() {
      try { return localStorage.getItem(STORAGE_KEY); } catch (_) { return null; }
    }

    var banner = document.getElementById('gdpr-banner');
    var acceptBtn = document.getElementById('gdpr-accept');
    var declineBtn = document.getElementById('gdpr-decline');

    var choice = readConsent();

    // Respect a prior opt-out: block GA before it can send anything.
    if (choice === 'declined') {
      window['ga-disable-' + GA_ID] = true;
    } else {
      // Default (no choice yet) or accepted: load analytics immediately.
      loadAnalytics();
    }

    // Show the notice only until the visitor has made a choice.
    if (choice !== 'accepted' && choice !== 'declined') {
      banner.style.display = 'block';
    }

    acceptBtn.addEventListener('click', function () {
      try { localStorage.setItem(STORAGE_KEY, 'accepted'); } catch (_) {}
      banner.style.display = 'none';
      loadAnalytics(); // no-op if already loaded
    });

    declineBtn.addEventListener('click', function () {
      try { localStorage.setItem(STORAGE_KEY, 'declined'); } catch (_) {}
      // Stop any further analytics hits in this session too.
      window['ga-disable-' + GA_ID] = true;
      banner.style.display = 'none';
    });

    // Let the privacy page (and anyone) re-open the notice to change choice.
    window.CookieConsent = {
      showPreferences: function () { banner.style.display = 'block'; }
    };
  })();
</script>
