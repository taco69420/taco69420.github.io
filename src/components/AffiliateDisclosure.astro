---
// Injected automatically by Layout.astro on any page whose own content contains
// an Amazon link. This is the near-the-top disclosure; the "As an Amazon
// Associate I earn from qualifying purchases" line in the footer is separate and
// required by Amazon, so neither one replaces the other.
---

<p class="affiliate-disclosure">
  Heads up: I earn a commission if you buy through my
  <a href="/privacy/#affiliate">Amazon links</a>. It doesn't change what I
  recommend.
</p>

<style>
  .affiliate-disclosure {
    font-size: 0.82rem;
    line-height: 1.5;
    color: #6b7280;
    border-left: 3px solid #d1fae5;
    padding: 0.1rem 0 0.1rem 0.75rem;
    margin: 1.25rem 0 1.75rem;
  }
  .affiliate-disclosure a {
    color: #047857;
    text-decoration: none;
    border-bottom: 1px solid #d1fae5;
  }
  .affiliate-disclosure a:hover {
    border-bottom-color: #047857;
  }
</style>
