---
// Points at /find-a-trapper/, the lead-referral form. Mark doesn't do paid
// trapping himself, so this is pitched as a referral, never as "my service" --
// see "The two location pages" in CLAUDE.md for the wording rules that
// scripts/audit/referral.mjs enforces.
//
// `variant="card"` (default) is the loud placement for the three hot pages.
// `variant="inline"` is a single sentence meant to read as one more line of
// body copy, for pages where affiliate content or DIY instruction should stay
// the focus.
interface Props {
  variant?: 'card' | 'inline';
  heading?: string;
  text?: string;
  linkText?: string;
}

const {
  variant = 'card',
  heading = "Don't want to do this yourself?",
  text = variant === 'card'
    ? "I don't do paid trapping myself, but I can connect you with a licensed local trapper in the Inland Empire. Tell me about your yard and I'll reach out within a day or two. I may be paid for referrals; it costs you nothing extra."
    : 'Not up for doing this yourself?',
  linkText = 'get matched with a licensed local trapper',
} = Astro.props;
---

{variant === 'card' ? (
  <aside class="hirecta-card" aria-labelledby="hirecta-heading">
    <p class="hirecta-eyebrow">Referral, not a service call</p>
    <h3 id="hirecta-heading" class="hirecta-heading">{heading}</h3>
    <p class="hirecta-text">{text}</p>
    <a href="/find-a-trapper/" class="btn">Get Matched With a Trapper →</a>
  </aside>
) : (
  <p class="hirecta-inline">{text} <a href="/find-a-trapper/">{linkText}</a>.</p>
)}

<style>
  .hirecta-card {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-left: 4px solid #d4af37;
    border-radius: 8px;
    padding: 1.1rem 1.35rem;
    margin: 1.5rem 0;
  }

  .hirecta-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #92400e;
    margin: 0 0 0.4rem;
  }

  .hirecta-heading {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: #1c1008;
  }

  .hirecta-text {
    margin: 0 0 0.9rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #57534e;
    max-width: 62ch;
  }

  .hirecta-inline {
    margin: 0;
  }
</style>
