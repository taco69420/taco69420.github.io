---
import Layout from '../layouts/Layout.astro';
import { breadcrumbSchema } from '../data/author';
import { updatedLine } from '../data/pageDates';
import { pageTitle } from '../data/site';

const route = '/find-a-trapper/';

// Resolved from the forms.gle share link. The share link stays as the fallback,
// since it is the one that keeps working if the long URL ever changes.
const FORM_ID = '1FAIpQLSe4O0uhTLbQTqpahPaXwnnhubyn3b_HMCbqQqgQEr42JEt7EQ';
const FORM_EMBED = `https://docs.google.com/forms/d/e/${FORM_ID}/viewform?embedded=true`;
const FORM_FALLBACK = 'https://forms.gle/ruoVGaFJiEzs4NJd9';

const crumbLabel = 'Find a Trapper';
const crumbSchema = breadcrumbSchema(crumbLabel, route);

// Deliberately no LocalBusiness / Service / Offer schema: this page refers work
// out to a licensed company, it does not advertise a service of Mark's.
---

<Layout
  title={pageTitle('Get Matched With a Licensed Gopher Trapper')}
  description="I don't do paid trapping myself. I'm lining up licensed trappers in Redlands and the Inland Empire — fill out one short form and I'll be in touch."
  schemas={[crumbSchema]}
  noindex
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › {crumbLabel}
  </nav>

  <header>
    <h1>Get Matched With a Licensed Gopher Trapper</h1>
    <p class="subtitle">
      I don't do paid trapping myself — fill this out and I'll reach out within one to two days.
    </p>
    <p class="dateline">{updatedLine(route)}</p>
  </header>

  <main>
    <aside class="referral-note">
      <p class="rn-body">
        <strong>I'm not a pest control company.</strong> Your info will go to a licensed local pest
        control business, who will contact you directly. I may be paid for referrals; it doesn't cost
        you anything extra.
      </p>
    </aside>

    <section class="card">
      <h2 id="form" class="visually-hidden">The form</h2>
      <div class="form-frame">
        <iframe
          src={FORM_EMBED}
          title="Request to be matched with a licensed gopher trapper in Redlands or the Inland Empire"
          loading="lazy"
          width="100%"
          height="1900"
          frameborder="0"
          marginheight="0"
          marginwidth="0">Loading…</iframe>
      </div>
      <p class="form-fallback">
        Form not loading? <a href={FORM_FALLBACK} target="_blank" rel="noopener">Open it here</a>.
      </p>
    </section>

    <section class="card">
      <h2 id="coverage">Where the partner trappers work</h2>
      <p>
        The trappers I'm lining up work Redlands and the wider Inland Empire. I'm still building that
        list, so I'm not going to promise you a name on day one. If you're outside the area, send the
        form anyway — I'll tell you straight if I can't match you rather than hand your details to
        someone who'd drive two hours and charge you for it.
      </p>
      <p>
        If you'd rather just do it yourself, that's still what most of this site is for: the
        <a href="/quick-start/">step-by-step field process</a> and
        <a href="/best-gopher-traps/">the traps I actually set</a> will get a single gopher handled
        for the price of a sandwich.
      </p>
    </section>

    <section class="card">
      <h2 id="what-happens">What happens after you submit</h2>
      <ol>
        <li>I read it, usually the same day.</li>
        <li>
          I come back to you within one to two days, either with a licensed trapper who covers your
          ZIP or with an honest "I don't have anyone there yet". Anyone I do put you in touch with
          holds a California Department of Pesticide Regulation licence — worth checking yourself
          too, which <a href="/methods/hiring-a-pro/">hiring a professional trapper</a> explains how to do.
        </li>
        <li>
          If there's a match, they contact you directly to quote the work. Any agreement is between
          you and them.
        </li>
      </ol>
      <p>
        What gets shared, and how I may be paid, are spelled out in the
        <a href="/privacy/#referrals">privacy notice</a>.
      </p>
    </section>
  </main>
</Layout>

<style>
  .referral-note {
    background: #fffbeb;
    border: 1px solid #fcd34d;
    border-left: 4px solid #d4af37;
    border-radius: 6px;
    padding: 1rem 1.35rem;
    margin: 0 0 1.5rem;
  }

  .rn-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #92400e;
    margin: 0 0 0.4rem;
  }

  .rn-body {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #78350f;
  }

  /* The form is the first thing on the page now, so a visible "The form"
     heading above it is just noise — but the section still needs a heading for
     the document outline and for screen readers. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* The embed is a fixed-height iframe rather than a ratio box: a Google Form
     is a tall column, and an aspect-ratio wrapper would crop it.
     Google Forms is cross-origin so it cannot report its own height, and the
     form gets TALLER as the viewport narrows (questions wrap). These numbers are
     measured, not guessed — see "Measuring the form iframe" in CLAUDE.md.
     Content height by viewport: 1824px at 900px+, 1834 at 768, 1878 at 640,
     2021 at 480, 2104 at 412, 2163 at 390, 2318 at 360, 2495 at 320. The earlier
     1600/1900 values clipped the Submit button at every width. */
  .form-frame {
    width: 100%;
    margin: 0.5rem 0 0.75rem;
  }

  .form-frame iframe {
    height: 1900px;
    display: block;
    width: 100%;
    max-width: 100%;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    background: #fff;
  }

  .form-fallback {
    font-size: 0.9rem;
    color: #6b7280;
    margin: 0;
  }

  /* Stepped so no width carries a large empty gap below the Submit button. */
  @media (max-width: 640px) { .form-frame iframe { height: 2000px; } }
  @media (max-width: 500px) { .form-frame iframe { height: 2200px; } }
  @media (max-width: 400px) { .form-frame iframe { height: 2250px; } }
  @media (max-width: 370px) { .form-frame iframe { height: 2400px; } }
  @media (max-width: 340px) { .form-frame iframe { height: 2550px; } }
</style>
