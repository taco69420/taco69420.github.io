---
import Layout from '../layouts/Layout.astro';
import { updatedLine } from '../data/pageDates';
import { pageTitle, REVIEW_YEAR } from '../data/site';
import { authorRef, breadcrumbSchema, SITE_URL } from '../data/author';
import { bestOfProducts } from '../data/bestOfProducts';
import { datesFor } from '../data/pageDates';

const route = "/best-gopher-poison/";
const heading = `Best Gopher Poison of ${REVIEW_YEAR}`;
const dates = datesFor(route)!;
const products = bestOfProducts[route];
const product = Object.fromEntries(products.map((p) => [p.id, p]));

// Spelled out so the intro sentence can't drift from the actual product count.
const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five'];
const productCountWord = NUMBER_WORDS[products.length] ?? String(products.length);

// `datePublished` is absent on purpose: pageDates has no recorded publish
// date for the best-of pages, and inventing one would be worse than omitting.
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": heading,
  "author": authorRef,
  "publisher": authorRef,
  "image": `${SITE_URL}/taco.jpg`,
  "datePublished": dates.published,
  "dateModified": dates.updated,
  "url": `${SITE_URL}${route}`,
};

// Pros/cons come from the same arrays the page renders below, so the review
// notes always match the visible lists. No ratings or offers by design.
const notes = (items: string[]) => ({
  "@type": "ItemList",
  "itemListElement": items.map((text, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": text,
  })),
});

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": heading,
  "itemListElement": products.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Product",
      "name": p.name,
      "url": `${SITE_URL}${route}#${p.id}`,
      "review": {
        "@type": "Review",
        "author": authorRef,
        "positiveNotes": notes(p.pros),
        "negativeNotes": notes(p.cons),
      },
    },
  })),
};

const crumbLabel = "Best Gopher Poison";
const crumbSchema = breadcrumbSchema(crumbLabel, route);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the most effective gopher poison?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For a California homeowner the question mostly answers itself: anticoagulant baits including diphacinone have been prohibited for residential use since January 1, 2024, which leaves zinc phosphide where the label lists pocket gophers. Placed correctly inside an active run it works. Traps work better and carry no carcass risk, which is why they are still my first choice."
      }
    },
    {
      "@type": "Question",
      "name": "Is gopher poison safe around other animals?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Secondary poisoning is a real-world risk — a dog, cat, hawk, or owl that eats a gopher killed by rodenticide can be poisoned by the active ingredient still in the gopher's system. If pets or wildlife are present, use mechanical traps instead. This risk does not go away with careful placement; it is inherent to any rodenticide approach."
      }
    },
    {
      "@type": "Question",
      "name": "How long does gopher poison take to work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zinc phosphide bait: 24–48 hours. Gopher gassers: same day in a properly sealed system, though UC IPM found cartridge fumigation isn't effective because gophers can seal off their burrows rapidly. CO burrow treatment: same day to 48 hours. No new mound activity within 7 days of placement means either the run was inactive, the bait wasn't taken, or the gopher moved on before treatment."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need a license to use gopher poison?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In California, most uses of diphacinone have been prohibited since January 1, 2024, including residential and home uses, and products labelled for those prohibited uses can only be sold to an end user by a DPR-licensed pest control dealer. Baits containing 2% zinc phosphide are available with exemptions for home use. Always read the full product label — it is the legal document that governs proper use, and following it exactly is required by law, not optional."
      }
    }
  ]
};
---

<Layout
  title={pageTitle(`Best Gopher Poison of ${REVIEW_YEAR}: Honest Review`)}
  description="Which gopher poisons actually kill, and which ones put your dog at risk. Rodenticide bait, gassers, and CO treatment compared with honest safety guidance."
  schemas={[articleSchema, itemListSchema, crumbSchema, faqSchema]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › {crumbLabel}
  </nav>

  <header class="poison-hero">
    <span class="hero-badge">🐾 Check Pet Safety First</span>
    <h1>{heading}</h1>
    <p class="hero-sub">Last resort. Not first move. If you're here, make sure you've read the safety section before you buy anything.</p>
    <p class="hero-dateline">{updatedLine(Astro.url.pathname)}</p>
  </header>

  <main>

    <section class="card" style="border-left: 4px solid #dc2626;">
      <p style="margin: 0 0 0.75rem; color: #374151; font-size: 0.95rem;"><strong>Before we get into product picks:</strong> If you have dogs, cats, or raptors on or near your property, stop here. Secondary poisoning from any rodenticide — bait pellets or fumigants — is a real risk, not a label formality. A dog that eats a bait-killed gopher can be killed by the same rodenticide. Use <a href="/best-gopher-traps/">mechanical traps</a> instead.</p>
      <p style="margin: 0; color: #374151; font-size: 0.95rem;">For properties without pets or wildlife concerns, chemical control is a legitimate tool — especially on large or deeply established tunnel systems where trapping alone isn't keeping up. The {productCountWord} products below are what I'd reach for first based on my experience with these methods — selected for effectiveness, availability, and realistic DIY use.</p>
    </section>

    <nav class="card" aria-label="Table of contents" style="border-left: 4px solid #059669; padding: 1rem 1.5rem;">
      <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #6b7280; margin: 0 0 0.65rem;">In This Guide</p>
      <ul style="margin: 0; padding-left: 1.1rem; line-height: 1.9; font-size: 0.9rem;">
        <li><a href="#quick-picks">Quick Picks</a></li>
        {products.map((p) => (
          <li><a href={`#${p.id}`}>{p.tocName}</a></li>
        ))}
<li><a href="#buying-guide">What to Know Before Using Gopher Poison</a></li>
        <li><a href="#faq">Frequently Asked Questions</a></li>
      </ul>
    </nav>

    <!-- Quick Picks Table -->
    <section class="card">
      <h2 id="quick-picks">Quick Picks</h2>
      <div style="overflow-x: auto;">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Best For</th>
              <th>Price Tier</th>
              <th>Buy</th>
            </tr>
          </thead>
          <tbody>
            {products.map((p) => (
              <tr>
                <td><strong>{p.tableName}</strong></td>
                <td>{p.bestFor}</td>
                <td><span class={`tier-badge tier-${p.tier}`}>{p.tier === 'budget' ? 'Budget' : p.tier === 'mid' ? 'Mid' : 'Premium'}</span></td>
                <td><a href={p.url} class="table-btn" target="_blank" rel="sponsored noopener">Shop →</a></td>
              </tr>
            ))}
</tbody>
        </table>
      </div>
    </section>

    <!-- Product 1: Underground Bait Stations -->
    <section class="card product-section">
      <div class="product-badge badge-best">Most Effective Rodenticide</div>
      <h2 id="bait-stations" class="ps-name">Underground Bait Applicator</h2>
      <p class="ps-best-for"><strong>Best for:</strong> Pet-free properties where you need lethal control on established tunnel systems — particularly useful when trapping sessions aren't producing results over multiple days.</p>
      <p class="ps-desc">Zinc phosphide bait pellets placed inside active gopher tunnels. The mechanism is straightforward: <a href="/traps/">probe</a> to locate the main lateral tunnel, open a clean access hole, place the labeled bait dose 6–8 inches inside the run, and cover the hole so light doesn't get in. The gopher encounters the bait during normal tunnel activity and consumes a lethal dose. Zinc phosphide acts at 24–48 hours but is sensitive to soil moisture and requires extra PPE during handling due to off-gassing. Diphacinone used to be a common choice here; it is now prohibited for residential use in California. Note: the tool linked here is the underground applicator that places the dose at tunnel depth — you load it with registered bait pellets, which are sold separately.</p>
      <div class="ps-verdict">
        <div class="ps-pros">
          <h3>Pros</h3>
          <ul>
            {product["bait-stations"].pros.map((pro) => <li>{pro}</li>)}
          </ul>
        </div>
        <div class="ps-cons">
          <h3>Cons</h3>
          <ul>
            {product["bait-stations"].cons.map((con) => <li>{con}</li>)}
          </ul>
        </div>
      </div>
      <div class="safety-callout">
        <strong>Safety:</strong> Secondary poisoning risk is real. Dogs, cats, hawks, and owls that consume a bait-killed gopher can be fatally poisoned. Do not use on any property with pets or known raptor activity. Keep away from children. Follow label directions exactly — the label is a legal document.
      </div>
      <a href="https://amzn.to/46XnfTH" class="btn" target="_blank" rel="sponsored noopener">Shop Underground Bait Applicator on Amazon →</a>
    </section>

    <!-- Product 2: Gopher Gassers -->
    <section class="card product-section">
      <div class="product-badge badge-budget">Cartridge Fumigant — Read the Research First</div>
      <h2 id="gassers" class="ps-name">Gopher Gassers (Fumigation Cartridges)</h2>
      <p class="ps-best-for"><strong>Best for:</strong> Mid-depth tunnel systems where you can't locate or access the main run effectively, and where every tunnel exit can be sealed before treatment.</p>
      <p class="ps-desc">Light the fuse, drop the burning cartridge into the tunnel, immediately seal the entrance with tamped soil. The cartridge generates gas as it burns, filling the tunnel system. This only works if every exit is sealed first — even one open hole vents the system and renders the treatment ineffective. Walk the yard and plug every mound you can find before you light anything. I use gassers when I'm dealing with a complex system where traps keep missing and I can't get a clean probe read on the active run. Post-rain or post-irrigation is ideal — compacted wet soil holds the gas in the system much better than dry, loose soil.</p>
      <div class="ps-verdict">
        <div class="ps-pros">
          <h3>Pros</h3>
          <ul>
            {product["gassers"].pros.map((pro) => <li>{pro}</li>)}
          </ul>
        </div>
        <div class="ps-cons">
          <h3>Cons</h3>
          <ul>
            {product["gassers"].cons.map((con) => <li>{con}</li>)}
          </ul>
        </div>
      </div>
      <div class="safety-callout">
        <strong>Safety:</strong> A gasser is a cartridge you light and bury, so it is a fire hazard as well as a gas hazard — never under or near structures, decks, porches, dry vegetation or mulch, and follow the label. Never use within 15 feet of occupied structures or crawl spaces. The combustion gas travels underground and can enter structures through foundation gaps. Keep children and pets away from the treated area.
      </div>
      <a href="https://amzn.to/4b4oF11" class="btn" target="_blank" rel="sponsored noopener">Shop Gopher Gassers on Amazon →</a>
    </section>

    <!-- Buying Guide -->
    <section class="card">
      <h2 id="buying-guide">What to Know Before Using Gopher Poison</h2>
      <p style="color: #374151; font-size: 0.95rem; margin-bottom: 0.5rem;">Chemical gopher control is effective when matched to the right situation. Here's what matters before you choose a product:</p>
      <dl class="buying-guide">
        <dt>Pets and wildlife first — full stop</dt>
        <dd>If dogs, cats, or birds of prey are present on or adjacent to your property, chemical control is off the table. Secondary poisoning risk from any rodenticide is real and documented. The only safe options in that scenario are mechanical traps — see the <a href="/best-gopher-traps/">Best Gopher Traps page</a> for picks.</dd>

        <dt>Match the method to the tunnel depth</dt>
        <dd>Bait pellets work best in standard-depth residential systems (6–12 inches) where you can probe and locate the main run. Cartridge gassers work in mid-depth systems where exits can be sealed. CO injection is the right call for deep, complex, established networks where neither of the other approaches can reach effectively.</dd>

        <dt>Which baits you can actually use in California</dt>
        <dd>Anticoagulants — diphacinone and chlorophacinone — are no longer legal for residential use in California, prohibited since January 1, 2024. Baits containing 2% zinc phosphide are available with exemptions for home use, so that is the homeowner option if the label lists pocket gophers. On carcass risk the two classes differ: zinc phosphide is not stored in the animal's tissue, while anticoagulants persist in the liver. Anticoagulants are the class California restricted. Don't read that as pet-safe. Zinc phosphide is acutely toxic, and a dog that eats the bait — or a freshly killed gopher with bait still in its stomach — can be poisoned. It is the remaining legal option for a California homeowner, not a safe one.</dd>

        <dt>Check your state's regulations</dt>
        <dd>In California and several other states, certain rodenticide formulations require a Pest Control Operator license to purchase and apply. Check CDPR requirements before ordering. The label is the controlling legal document — following it is not optional.</dd>
      </dl>
      <p style="margin-top: 1.25rem; margin-bottom: 0; font-size: 0.875rem; color: #6b7280;">Full method guides: <a href="/methods/poison-bait-stations/">Underground Bait Station →</a> &nbsp;·&nbsp; <a href="/methods/carbon-monoxide/">CO Burrow Treatment →</a> &nbsp;·&nbsp; <a href="/methods/hiring-a-pro/">When to Hire a Pro →</a></p>
    </section>

    <!-- FAQ -->
    <section class="card">
      <h2 id="faq">Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>What is the most effective gopher poison?</summary>
          <p>For a California homeowner the question mostly answers itself: anticoagulant baits including diphacinone have been prohibited for residential use since January 1, 2024, which leaves zinc phosphide where the label lists pocket gophers. Placed correctly inside an active run it works. Traps work better and carry no carcass risk, which is why they are still my first choice.</p>
        </details>
        <details class="faq-item">
          <summary>Is gopher poison safe around other animals?</summary>
          <p>No. Secondary poisoning is a real-world risk — a dog, cat, hawk, or owl that eats a gopher killed by rodenticide can be poisoned by the active ingredient still in the gopher's system. If pets or wildlife are present, use <a href="/best-gopher-traps/">mechanical traps</a> instead. This risk does not go away with careful placement; it is inherent to any rodenticide approach.</p>
        </details>
        <details class="faq-item">
          <summary>How long does gopher poison take to work?</summary>
          <p>Zinc phosphide bait: 24–48 hours. Gopher gassers: same day in a properly sealed system, though UC IPM found cartridge fumigation isn't effective because gophers can seal off their burrows rapidly. CO burrow treatment: same day to 48 hours. No new <a href="/problems/mound-id/">mound</a> activity within 7 days of placement means either the run was inactive, the bait wasn't taken, or the gopher moved on before treatment.</p>
        </details>
        <details class="faq-item">
          <summary>Do I need a license to use gopher poison?</summary>
          <p>In California, most uses of diphacinone have been prohibited since January 1, 2024, including residential and home uses, and products labelled for those prohibited uses can only be sold to an end user by a DPR-licensed pest control dealer. Baits containing 2% zinc phosphide are available with exemptions for home use. Always read the full product label — it is the legal document that governs proper use, and following it exactly is required by law, not optional.</p>
        </details>
      </div>
    </section>

    <section class="card related-section">
      <p class="related-label">Related guides</p>
      <div class="related-grid">
        <a href="/best-gopher-traps/" class="related-card">Best Gopher Traps of 2026 — safer alternative →</a>
        <a href="/best-gopher-baits/" class="related-card">Best Gopher Baits of 2026 →</a>
        <a href="/problems/pet-safety/" class="related-card">Keeping Pets Safe Around Gopher Control →</a>
        <a href="/cost/" class="related-card">Gopher Control Cost Guide →</a>
      </div>
    </section>

  </main>
</Layout>

<style>
  .product-section { margin-bottom: 1.5rem; }

  /* ── Poison hero ── */
  .poison-hero {
    background: #18181b;
    color: #f4f4f5;
    padding: 2.25rem 2rem 2rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    border-left: 4px solid #3f3f46;
  }

  .poison-hero .hero-badge {
    display: inline-block;
    background: #3f3f46;
    color: #e4e4e7;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.85rem;
  }

  .poison-hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: #ffffff;
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }

  .poison-hero .hero-sub {
    font-size: 1rem;
    color: #a1a1aa;
    margin: 0 0 0.9rem;
    line-height: 1.65;
    max-width: 52ch;
  }

  .poison-hero .hero-dateline {
    font-size: 0.78rem;
    color: #52525b;
    margin: 0;
  }

  .ps-name {
    font-size: 1.3rem;
    color: #065f46;
    margin: 0.4rem 0 0.5rem;
    font-weight: 700;
  }

  .ps-best-for {
    font-size: 0.9rem;
    color: #374151;
    margin-bottom: 0.75rem;
  }

  .ps-best-for strong { color: #047857; }

  .ps-desc {
    color: #374151;
    font-size: 0.95rem;
    margin-bottom: 1rem;
    line-height: 1.65;
  }

  .ps-verdict {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1rem 0;
  }

  .ps-pros, .ps-cons {
    padding: 0.85rem 1rem;
    border-radius: 8px;
  }

  .ps-pros { background: #f0fdf4; border: 1px solid #6ee7b7; }
  .ps-cons { background: #fff1f2; border: 1px solid #fda4af; }

  .ps-pros h3 {
    color: #065f46;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.5rem;
  }

  .ps-cons h3 {
    color: #9f1239;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.5rem;
  }

  .ps-pros ul, .ps-cons ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.875rem;
    color: #374151;
    line-height: 1.6;
  }

  .ps-pros li, .ps-cons li { margin-bottom: 0.3rem; }

  .safety-callout {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-left: 4px solid #dc2626;
    border-radius: 6px;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: #7f1d1d;
    margin: 0.75rem 0;
    line-height: 1.55;
  }

  .safety-callout strong { color: #991b1b; }

  .product-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
    width: fit-content;
  }

  .badge-best { background: #065f46; color: #fff; }
  .badge-budget { background: #f0fdf4; color: #065f46; border: 1.5px solid #6ee7b7; }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .compare-table thead tr { background: #f4f4f5; }

  .compare-table th {
    text-align: left;
    padding: 0.55rem 0.9rem;
    border-bottom: 2px solid #e4e4e7;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
  }

  .compare-table td {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid #e4e4e7;
    vertical-align: middle;
  }

  .compare-table tr:last-child td { border-bottom: none; }
  .compare-table tr:nth-child(even) { background: #fafafa; }

  .tier-badge {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tier-budget { background: #f0fdf4; color: #065f46; border: 1px solid #6ee7b7; }
  .tier-mid { background: #fffbeb; color: #92400e; border: 1px solid #fcd34d; }
  .tier-premium { background: #fff1f2; color: #9f1239; border: 1px solid #fda4af; }

  .table-btn {
    display: inline-block;
    background: #059669;
    color: white !important;
    padding: 0.35rem 0.85rem;
    text-decoration: none !important;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.78rem;
    white-space: nowrap;
    border-bottom: none !important;
    transition: background 0.15s;
  }

  .table-btn:hover {
    background: #047857;
    color: white !important;
    border-bottom: none !important;
  }

  .buying-guide { margin: 0.5rem 0 0; }

  .buying-guide dt {
    font-weight: 600;
    color: #18181b;
    font-size: 0.95rem;
    margin-top: 1rem;
    margin-bottom: 0.2rem;
  }

  .buying-guide dd {
    margin: 0;
    color: #374151;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .ps-verdict { grid-template-columns: 1fr; }
    .compare-table th:nth-child(2),
    .compare-table td:nth-child(2) { display: none; }
  }
  .related-section { border-left: 4px solid #059669; padding: 1rem 1.5rem; }
  .related-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #6b7280; margin: 0 0 0.75rem; }
  .related-grid { display: flex; flex-direction: column; gap: 0.5rem; }
  .related-card { display: block; background: #f0fdf4; border: 1px solid #6ee7b7; border-radius: 6px; padding: 0.6rem 0.9rem; font-size: 0.9rem; font-weight: 500; color: #047857; text-decoration: none; transition: background 0.15s, border-color 0.15s; }
  .related-card:hover { background: #dcfce7; border-color: #34d399; text-decoration: none; }
</style>