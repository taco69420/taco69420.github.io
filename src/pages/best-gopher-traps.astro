---
import Layout from '../layouts/Layout.astro';
import { updatedLine } from '../data/pageDates';
import { pageTitle, REVIEW_YEAR } from '../data/site';
import { authorRef, breadcrumbSchema, SITE_URL } from '../data/author';
import { bestOfProducts } from '../data/bestOfProducts';
import { datesFor } from '../data/pageDates';

const route = "/best-gopher-traps/";
const heading = `Best Gopher Traps of ${REVIEW_YEAR}`;
const dates = datesFor(route)!;
const products = bestOfProducts[route];
const product = Object.fromEntries(products.map((p) => [p.id, p]));

// `datePublished` is absent on purpose: pageDates has no recorded publish
// date for the best-of pages, and inventing one would be worse than omitting.
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": heading,
  "author": authorRef,
  "publisher": authorRef,
  "image": `${SITE_URL}/taco.jpg`,
  "datePublished": dates.published,
  "dateModified": dates.updated,
  "url": `${SITE_URL}${route}`,
};

// Pros/cons come from the same arrays the page renders below, so the review
// notes always match the visible lists. No ratings or offers by design.
const notes = (items: string[]) => ({
  "@type": "ItemList",
  "itemListElement": items.map((text, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": text,
  })),
});

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": heading,
  "itemListElement": products.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Product",
      "name": p.name,
      "url": `${SITE_URL}${route}#${p.id}`,
      "review": {
        "@type": "Review",
        "author": authorRef,
        "positiveNotes": notes(p.pros),
        "negativeNotes": notes(p.cons),
      },
    },
  })),
};

const crumbLabel = "Best Gopher Traps";
const crumbSchema = breadcrumbSchema(crumbLabel, route);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the best gopher trap for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cinch Traps are the most forgiving starting point — the scissor-jaw mechanism is more intuitive and less prone to accidental misfires during placement. Victor Easy Set traps are cheaper and just as effective once you learn the technique, but the arming process has a steeper learning curve."
      }
    },
    {
      "@type": "Question",
      "name": "How many gopher traps do I need?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Always set two traps per gopher, facing opposite directions in the same main tunnel run. One trap leaves an escape route. Two back-to-back facing opposite directions cuts it off entirely. For a standard single-gopher yard, 2 minimum. For a property with regular pressure, 6–8 lets you work multiple runs simultaneously instead of chasing one gopher across the yard."
      }
    },
    {
      "@type": "Question",
      "name": "Should I use bait with gopher traps?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bait isn't required — mechanical traps fire on movement, not scent, and UC Davis studies found no benefit from adding bait to traps. I still dab a bit of peanut butter behind the trigger plate on most of my own sets, but that's personal habit, not a catch-rate claim — placement and technique are what actually matter."
      }
    },
    {
      "@type": "Question",
      "name": "How do I know if my trap placement is correct?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The trap should sit fully inside the main tunnel with the jaws spanning the full width of the run, and no soil touching the trigger. Cover the hole so light doesn't get in, which is what UC IPM instructs. Check daily. If nothing has happened in one to two days, the run wasn't active at that location; move the trap."
      }
    }
  ]
};
---

<Layout
  title={pageTitle(`Best Gopher Traps of ${REVIEW_YEAR}: 3 Tested Picks`)}
  description="Victor Easy Set, Victor Black Box, and Cinch traps compared on price, speed, and how forgiving each one is to set. Which to buy for your first tunnel run."
  schemas={[articleSchema, itemListSchema, crumbSchema, faqSchema]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › {crumbLabel}
  </nav>

  <header class="traps-hero">
    <span class="hero-badge">⚡ Fastest Results</span>
    <h1>{heading}</h1>
    <p class="hero-sub">I've been setting these since I was 15. These three are the ones that actually catch gophers.</p>
    <p class="hero-dateline">{updatedLine(Astro.url.pathname)}</p>
  </header>

  <main>

    <section class="card" style="border-left: 4px solid #10b981;">
      <p style="margin: 0; color: #374151; font-size: 0.95rem;">Mechanical trapping is the most reliable gopher control method I know. No poison risk to pets or birds of prey, no waiting days for a chemical to work — you set the trap, check it, and either have a gopher or move the trap. I've tested a lot of trap styles over the years. The three on this page are the ones that produce results consistently and have earned a permanent spot in my kit.</p>
    </section>

    <nav class="card" aria-label="Table of contents" style="border-left: 4px solid #059669; padding: 1rem 1.5rem;">
      <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #6b7280; margin: 0 0 0.65rem;">In This Guide</p>
      <ul style="margin: 0; padding-left: 1.1rem; line-height: 1.9; font-size: 0.9rem;">
        <li><a href="#quick-picks">Quick Picks</a></li>
        {products.map((p) => (
          <li><a href={`#${p.id}`}>{p.tocName}</a></li>
        ))}
<li><a href="#buying-guide">What to Look For in a Gopher Trap</a></li>
        <li><a href="#faq">Frequently Asked Questions</a></li>
      </ul>
    </nav>

    <!-- Quick Picks Table -->
    <section class="card">
      <h2 id="quick-picks">Quick Picks</h2>
      <div style="overflow-x: auto;">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Best For</th>
              <th>Price Tier</th>
              <th>Buy</th>
            </tr>
          </thead>
          <tbody>
            {products.map((p) => (
              <tr>
                <td><strong>{p.tableName}</strong></td>
                <td>{p.bestFor}</td>
                <td><span class={`tier-badge tier-${p.tier}`}>{p.tier === 'budget' ? 'Budget' : p.tier === 'mid' ? 'Mid' : 'Premium'}</span></td>
                <td><a href={p.url} class="table-btn" target="_blank" rel="sponsored noopener">Shop →</a></td>
              </tr>
            ))}
</tbody>
        </table>
      </div>
    </section>

    <!-- Product 1: Victor Easy Set -->
    <section class="card product-section">
      <div class="product-badge badge-best">Best Overall</div>
      <h2 id="victor-easy-set" class="ps-name">Victor Easy Set Gopher Trap</h2>
      <p class="ps-best-for"><strong>Best for:</strong> Main tunnel intercept on active runs — the highest consistent catch rate of any mechanical trap I've used since I started trapping at 15.</p>
      <p class="ps-desc">The Victor Easy Set is a Macabee-pattern wire trap that's been the standard for serious gopher trappers for decades. Two spring-loaded wire arms close across the tunnel when the trigger plate is activated. Set two of them back-to-back facing opposite directions in the main run, cover the opening so light doesn't get in, and check daily — if nothing in one to two days, move them. When the run is active and placement is right, you will catch a gopher. The mechanism is simple, which is exactly why it works.</p>
      <div class="ps-verdict">
        <div class="ps-pros">
          <h3>Pros</h3>
          <ul>
            {product["victor-easy-set"].pros.map((pro) => <li>{pro}</li>)}
          </ul>
        </div>
        <div class="ps-cons">
          <h3>Cons</h3>
          <ul>
            {product["victor-easy-set"].cons.map((con) => <li>{con}</li>)}
          </ul>
        </div>
      </div>
      <a href="https://amzn.to/4cIJ64V" class="btn" target="_blank" rel="sponsored noopener">Shop Victor Easy Set on Amazon →</a>
    </section>

    <!-- Product 2: Victor Black Box -->
    <section class="card product-section">
      <div class="product-badge badge-budget">Safest Around Pets</div>
      <h2 id="victor-black-box" class="ps-name">Victor Black Box Gopher Trap</h2>
      <p class="ps-best-for"><strong>Best for:</strong> Households with dogs or kids — the fully enclosed box has no exposed jaws, and it sets without opening a large hole in the run.</p>
      <p class="ps-desc">The Victor Black Box is a fully enclosed gopher trap — the gopher enters the box and trips a choker mechanism inside. Because the jaws are enclosed, there are no exposed springs near curious fingers, paws, or noses, and you can set it with a smaller tunnel opening than a bare wire trap. It's a touch slower to catch than an open wire set in the same run, but the enclosed design and simpler placement make it the one I hand to people who are nervous about the wire traps.</p>
      <div class="ps-verdict">
        <div class="ps-pros">
          <h3>Pros</h3>
          <ul>
            {product["victor-black-box"].pros.map((pro) => <li>{pro}</li>)}
          </ul>
        </div>
        <div class="ps-cons">
          <h3>Cons</h3>
          <ul>
            {product["victor-black-box"].cons.map((con) => <li>{con}</li>)}
          </ul>
        </div>
      </div>
      <a href="https://amzn.to/4bqUakW" class="btn" target="_blank" rel="sponsored noopener">Shop Victor Black Box on Amazon →</a>
    </section>

    <!-- Product 3: Cinch Traps -->
    <section class="card product-section">
      <div class="product-badge" style="background: #fffbeb; color: #92400e; border: 1.5px solid #fcd34d;">Best for Beginners</div>
      <h2 id="cinch-traps" class="ps-name">Cinch Traps (Scissor-Jaw Style)</h2>
      <p class="ps-best-for"><strong>Best for:</strong> First-time trappers, or anyone who finds the Victor wire mechanism difficult to set consistently without accidental misfires during tunnel placement.</p>
      <p class="ps-desc">Cinch traps use a scissor-jaw mechanism that many people find more intuitive to arm than the Victor wire style. The trigger geometry is less prone to firing during placement in tight tunnels. I use these as my backup when Victor sets aren't producing in a particular run geometry, or when I'm working with someone new who needs a more forgiving tool to start learning on. Catch rate is comparable to Victor when placement is right — alignment still matters, but the margin for error is wider.</p>
      <div class="ps-verdict">
        <div class="ps-pros">
          <h3>Pros</h3>
          <ul>
            {product["cinch-traps"].pros.map((pro) => <li>{pro}</li>)}
          </ul>
        </div>
        <div class="ps-cons">
          <h3>Cons</h3>
          <ul>
            {product["cinch-traps"].cons.map((con) => <li>{con}</li>)}
          </ul>
        </div>
      </div>
      <a href="https://amzn.to/4sMH5cR" class="btn" target="_blank" rel="sponsored noopener">Shop Cinch Traps on Amazon →</a>
    </section>

    <!-- Buying Guide -->
    <section class="card">
      <h2 id="buying-guide">What to Look For in a Gopher Trap</h2>
      <p style="color: #374151; font-size: 0.95rem; margin-bottom: 0.5rem;">The trap is only part of the equation. Placement accuracy matters more than which trap you buy. That said, trap choice does matter — here's what to weigh:</p>
      <dl class="buying-guide">
        <dt>Tunnel intercept vs. attractant-based</dt>
        <dd>Every trap on this page works on tunnel intercept. You're not luring the gopher — you're cutting off its travel route. This is more reliable than bait-attraction designs because the gopher has to move through the run regardless of whether it's hungry or curious.</dd>

        <dt>Spring mechanism: wire vs. scissor-jaw</dt>
        <dd>Victor-style high-tension wire fires fast and leaves little room for a gopher to dodge. Scissor-jaw (Cinch) fires slightly slower but is much easier to arm safely. Both catch gophers when placed correctly — the choice is about technique preference and tolerance for accidental misfires during set.</dd>

        <dt>How many traps to buy</dt>
        <dd>Always set two traps per active run, one facing each direction. For a yard with one gopher, 2 traps minimum. For persistent pressure or multiple gophers, you want 6–8 so you can work every active run simultaneously and not be running back and forth resetting singles.</dd>

        <dt>Cost per trap</dt>
        <dd>The Victor Easy Set is the most affordable option — often the lowest cost per trap in multi-packs. The Black Box costs a little more for the enclosed, pet-safer design. Cinch traps cost more still, but the forgiving mechanism reduces the number of catches you lose to misaligned sets, which can make the math work out.</dd>
      </dl>
      <p style="margin-top: 1.25rem; margin-bottom: 0; font-size: 0.875rem; color: #6b7280;">Full technique walkthroughs: <a href="/methods/victor-traps/">Victor Trap Guide →</a> &nbsp;·&nbsp; <a href="/methods/cinch-traps/">Cinch Trap Guide →</a> &nbsp;·&nbsp; <a href="/traps/">The Armory — all gear picks →</a></p>
    </section>

    <!-- FAQ -->
    <section class="card">
      <h2 id="faq">Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>What is the best gopher trap for beginners?</summary>
          <p>Cinch Traps are the most forgiving starting point — the scissor-jaw mechanism is more intuitive and less prone to accidental misfires during placement. Victor Easy Set traps are cheaper and just as effective once you learn the technique, but the arming process has a steeper learning curve.</p>
        </details>
        <details class="faq-item">
          <summary>How many gopher traps do I need?</summary>
          <p>Always set two traps per gopher, facing opposite directions in the same main tunnel run. One trap leaves an escape route. Two back-to-back facing opposite directions cuts it off entirely. For a standard single-gopher yard, 2 minimum. For a property with regular pressure, 6–8 lets you work multiple runs simultaneously instead of chasing one gopher across the yard.</p>
        </details>
        <details class="faq-item">
          <summary>Should I use bait with gopher traps?</summary>
          <p>Bait isn't required — mechanical traps fire on movement, not scent, and UC Davis studies found no benefit from adding bait to traps. I still dab a bit of peanut butter behind the trigger plate on most of my own sets, but that's personal habit, not a catch-rate claim — placement and technique are what actually matter.</p>
        </details>
        <details class="faq-item">
          <summary>How do I know if my trap placement is correct?</summary>
          <p>The trap should sit fully inside the main tunnel with the jaws spanning the full width of the run, and no soil touching the trigger. Cover the hole so light doesn't get in, which is what UC IPM instructs. Check daily. If nothing has happened in one to two days, the run wasn't active at that location; move the trap.</p>
        </details>
      </div>
    </section>

    <section class="card related-section">
      <p class="related-label">Related guides</p>
      <div class="related-grid">
        <a href="/best-gopher-baits/" class="related-card">Best Gopher Baits of 2026 →</a>
        <a href="/best-gopher-poison/" class="related-card">Best Gopher Poison of 2026 →</a>
        <a href="/traps/" class="related-card">The Armory — all gear picks →</a>
        <a href="/cost/" class="related-card">Gopher Control Cost Guide →</a>
      </div>
    </section>

  </main>
</Layout>

<style>
  .product-section { margin-bottom: 1.5rem; }

  /* ── Traps hero ── */
  .traps-hero {
    background: #7f1d1d;
    color: #fff1f2;
    padding: 2.25rem 2rem 2rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }

  .traps-hero .hero-badge {
    display: inline-block;
    background: #fca5a5;
    color: #450a0a;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.85rem;
  }

  .traps-hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: #ffffff;
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }

  .traps-hero .hero-sub {
    font-size: 1rem;
    color: #fecaca;
    margin: 0 0 0.9rem;
    line-height: 1.65;
    max-width: 52ch;
  }

  .traps-hero .hero-dateline {
    font-size: 0.78rem;
    color: #f87171;
    margin: 0;
    opacity: 0.8;
  }

  .ps-name {
    font-size: 1.3rem;
    color: #065f46;
    margin: 0.4rem 0 0.5rem;
    font-weight: 700;
  }

  .ps-best-for {
    font-size: 0.9rem;
    color: #374151;
    margin-bottom: 0.75rem;
  }

  .ps-best-for strong { color: #047857; }

  .ps-desc {
    color: #374151;
    font-size: 0.95rem;
    margin-bottom: 1rem;
    line-height: 1.65;
  }

  .ps-verdict {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1rem 0;
  }

  .ps-pros, .ps-cons {
    padding: 0.85rem 1rem;
    border-radius: 8px;
  }

  .ps-pros { background: #f0fdf4; border: 1px solid #6ee7b7; }
  .ps-cons { background: #fff1f2; border: 1px solid #fda4af; }

  .ps-pros h3 {
    color: #065f46;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.5rem;
  }

  .ps-cons h3 {
    color: #9f1239;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.5rem;
  }

  .ps-pros ul, .ps-cons ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.875rem;
    color: #374151;
    line-height: 1.6;
  }

  .ps-pros li, .ps-cons li { margin-bottom: 0.3rem; }

  .product-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
    width: fit-content;
  }

  .badge-best { background: #065f46; color: #fff; }
  .badge-budget { background: #f0fdf4; color: #065f46; border: 1.5px solid #6ee7b7; }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .compare-table thead tr { background: #f4f4f5; }

  .compare-table th {
    text-align: left;
    padding: 0.55rem 0.9rem;
    border-bottom: 2px solid #e4e4e7;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
  }

  .compare-table td {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid #e4e4e7;
    vertical-align: middle;
  }

  .compare-table tr:last-child td { border-bottom: none; }
  .compare-table tr:nth-child(even) { background: #fafafa; }

  .tier-badge {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tier-budget { background: #f0fdf4; color: #065f46; border: 1px solid #6ee7b7; }
  .tier-mid { background: #fffbeb; color: #92400e; border: 1px solid #fcd34d; }
  .tier-premium { background: #fff1f2; color: #9f1239; border: 1px solid #fda4af; }

  .table-btn {
    display: inline-block;
    background: #059669;
    color: white !important;
    padding: 0.35rem 0.85rem;
    text-decoration: none !important;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.78rem;
    white-space: nowrap;
    border-bottom: none !important;
    transition: background 0.15s;
  }

  .table-btn:hover {
    background: #047857;
    color: white !important;
    border-bottom: none !important;
  }

  .buying-guide { margin: 0.5rem 0 0; }

  .buying-guide dt {
    font-weight: 600;
    color: #18181b;
    font-size: 0.95rem;
    margin-top: 1rem;
    margin-bottom: 0.2rem;
  }

  .buying-guide dd {
    margin: 0;
    color: #374151;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .ps-verdict { grid-template-columns: 1fr; }
    .compare-table th:nth-child(2),
    .compare-table td:nth-child(2) { display: none; }
  }
  .related-section { border-left: 4px solid #059669; padding: 1rem 1.5rem; }
  .related-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #6b7280; margin: 0 0 0.75rem; }
  .related-grid { display: flex; flex-direction: column; gap: 0.5rem; }
  .related-card { display: block; background: #f0fdf4; border: 1px solid #6ee7b7; border-radius: 6px; padding: 0.6rem 0.9rem; font-size: 0.9rem; font-weight: 500; color: #047857; text-decoration: none; transition: background 0.15s, border-color 0.15s; }
  .related-card:hover { background: #dcfce7; border-color: #34d399; text-decoration: none; }
</style>