    <script is:inline>
      // Skip-to-main: give the page's <main> element an id so the skip link works
      (function () {
        var main = document.querySelector('main');
        if (main && !main.id) { main.id = 'main-content'; main.setAttribute('tabindex', '-1'); }
      })();

      // Dropdown ARIA: sync aria-expanded with CSS focus-within open/close state
      (function () {
        document.querySelectorAll('.nav-dropdown').forEach(function (dd) {
          var btn = dd.querySelector('.nav-dropdown-btn');

          dd.addEventListener('focusin', function () {
            btn.setAttribute('aria-expanded', 'true');
          });

          dd.addEventListener('focusout', function (e) {
            if (!dd.contains(e.relatedTarget)) {
              btn.setAttribute('aria-expanded', 'false');
            }
          });

          btn.addEventListener('mouseenter', function () {
            btn.setAttribute('aria-expanded', 'true');
          });

          dd.addEventListener('mouseleave', function () {
            btn.setAttribute('aria-expanded', 'false');
          });
        });
      })();
